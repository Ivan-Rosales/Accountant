QComboBox {
    background-color: transparent;
    border: 1px solid #6c757d;
    border-radius: 6px;
    padding: 6px 8px;
    outline: none;
}

QComboBox QAbstractItemView {
    background-color: #212529;
    padding: 6px;
}

QComboBox QAbstractItemView::item {
    border-radius: 6px;
    padding: 1px 2px;
    margin-bottom: 3px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #6c757d;
    border-color: red;
}
