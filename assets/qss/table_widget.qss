QHeaderView {
    background-color: #1e2227;
    border: none;
}

QHeaderView::section {
    background-color: #1e2227;
    border: none;
    border-bottom: 1px solid #30363d;
    padding: 8px 6px;
    font-weight: 600;
    color: #8b949e;
}

QTableWidget {
    background-color: #1e2227;
    alternate-background-color: #21262b;
    border: 1px solid #30363d;
    border-radius: 12px;
    gridline-color: transparent;
}

QTableWidget::item {
    background-color: transparent;
    border-bottom: 1px solid #262b31;
    padding: 4px 6px;
}

QTableWidget::item:hover {
    background-color: #262b31;
}

QTableWidget::item:selected {
    background-color: #2b3138;
    color: #ffffff;
}

QTableWidget::item:focus {
    outline: none;
    border: none;
}

QTableCornerButton::section {
    background-color: #1e2227;
    border: none;
}

QTableWidget QComboBox {
    background-color: #262b31;
    border-radius: 6px;
    padding: 2px 8px;
    margin: 4px 2px;
    min-height: 22px;
}

QTableWidget::indicator {
    background-color: #16191d;
    border: 1px solid #4d555f;
    border-radius: 5px;
    width: 16px;
    height: 16px;
}

QTableWidget::indicator:hover {
    border-color: {{color}};
}

QTableWidget::indicator:checked {
    background-color: {{color}};
    border-color: {{color}};
}

QListWidget {
    background-color: #16191d;
    border: 1px solid #30363d;
    border-radius: 8px;
    padding: 4px;
    outline: none;
}

QListWidget::item {
    border-radius: 6px;
    padding: 6px 8px;
    margin: 1px 0;
}

QListWidget::item:hover {
    background-color: #262b31;
}

QListWidget::item:selected {
    background-color: #2b3138;
    color: #ffffff;
    border: 1px solid {{color}};
}

QListWidget::indicator {
    background-color: #1e2227;
    border: 1px solid #4d555f;
    border-radius: 5px;
    width: 16px;
    height: 16px;
}

QListWidget::indicator:checked {
    background-color: {{color}};
    border-color: {{color}};
}
