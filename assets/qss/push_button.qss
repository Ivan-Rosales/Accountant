QPushButton {
    background-color: #262b31;
    border: 1px solid #30363d;
    border-radius: 8px;
    padding: 8px 14px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #2f353c;
    border: 1px solid #3d444d;
}

QPushButton:pressed {
    background-color: #1e2227;
}

QPushButton:disabled {
    background-color: #1e2227;
    border: 1px solid #262b31;
    color: #5c636a;
}

/* Botón plano */

QPushButton[type~="flat"] {
    background-color: transparent;
    border: 1px solid transparent;
    color: #8b949e;
}

QPushButton[type~="flat"]:hover {
    background-color: #262b31;
    color: #e6e8eb;
}

QPushButton[type~="flat"]:pressed {
    background-color: #1e2227;
}

QPushButton[type~="flat"]:disabled {
    background-color: transparent;
    color: #5c636a;
}

/* Botón principal */

QPushButton[class~="primary"] {
    background-color: {{color}};
    border: 1px solid {{color}};
    color: {{text}};
}

QPushButton[class~="primary"]:hover {
    background-color: {{hover}};
    border: 1px solid {{border}};
}

QPushButton[class~="primary"]:pressed {
    background-color: {{border}};
    border: 1px solid {{pressed}};
}

QPushButton[class~="primary"]:disabled {
    background-color: {{color}};
    border: 1px solid {{color}};
    color: {{text}};
}

/* Botón de acción destructiva */

QPushButton[class~="danger"] {
    background-color: #da3633;
    border: 1px solid #da3633;
    color: #ffffff;
}

QPushButton[class~="danger"]:hover {
    background-color: #e5534b;
    border: 1px solid #e5534b;
}

QPushButton[class~="danger"]:pressed {
    background-color: #b62324;
}

/* Selector segmentado (pestañas internas) */

QPushButton[class~="segment"] {
    background-color: #1e2227;
    border: 1px solid #30363d;
    border-radius: 0;
    padding: 8px 16px;
    color: #8b949e;
}

QPushButton[class~="segment"][position~="first"] {
    border-top-left-radius: 8px;
    border-bottom-left-radius: 8px;
}

QPushButton[class~="segment"][position~="last"] {
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
}

QPushButton[class~="segment"]:hover {
    color: #e6e8eb;
}

QPushButton[class~="segment"]:checked {
    background-color: #262b31;
    border-color: {{color}};
    color: #ffffff;
}
